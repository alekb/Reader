rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per parent account holding the progress of the child from
    // before several children were supported.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['progress', 'updatedAt', 'resetAt', 'email'])
        && (!('progress' in request.resource.data) || request.resource.data.progress is map);

      // One document per learning session (small logs).
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.id == sessionId
          && request.resource.data.keys().size() < 30;
      }

      // Every other child: their progress, and their sessions underneath.
      match /children/{childId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['progress', 'updatedAt', 'resetAt'])
          && (!('progress' in request.resource.data) || request.resource.data.progress is map);

        match /sessions/{sessionId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.id == sessionId
            && request.resource.data.keys().size() < 30;
        }
      }

      // Children removed on any device, so other devices do not upload them again.
      match /meta/removed {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['ids'])
          && request.resource.data.ids is list
          && request.resource.data.ids.size() <= 500;
      }

      // Parent voice recordings of the letter sounds (short clips, base64).
      match /recordings/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['key', 'b64', 'type', 'updatedAt'])
          && request.resource.data.b64 is string
          && request.resource.data.b64.size() < 400000;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
