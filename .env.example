# Copy this file to .env and fill in the values from your Firebase project:
# Firebase console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
# If these are left empty, the app still works fully offline with progress saved on the device only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local testing only: run against the Firebase emulators on this host (auth :9099, Firestore :8080).
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Only needed to (re)generate the bundled audio with `npm run audio`. Never shipped in the app.
GOOGLE_TTS_API_KEY=
