# Optional: the app already uses the Reader Quest Firebase project (src/firebase/config.ts).
# Fill these in only to point a build at a different Firebase project:
# Firebase console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
# Left empty, the built-in project is used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed to (re)generate the bundled audio with `npm run audio`. Never shipped in the app.
GOOGLE_TTS_API_KEY=
